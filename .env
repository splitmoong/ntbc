# NTBC Configuration
# Edit these paths once — they will be auto-loaded by the UI on startup.

# Compressonator CLI executable (needed for PNG → BC1 DDS compression)
NTBC_COMPRESSONATOR_CLI=C:\Compressonator_4.5.52\bin\CLI\compressonatorcli.exe

# Source PNG images folder (original textures, e.g. 4K PNGs)
NTBC_PNG_FOLDER=C:/Users/Akshay/Documents/4k

# Pre-compressed DDS reference folder
# Leave blank to let the pipeline auto-create DDS files from PNGs
NTBC_DDS_FOLDER=C:/Users/Akshay/Documents/dds

# Output directory (datasets, trained model, inference results)
NTBC_OUTPUT_DIR=C:/Users/Akshay/Documents/out

# Training hyperparameters
NTBC_STEPS=20000
NTBC_BATCH=4096
NTBC_DEVICE=cpu
